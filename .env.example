# NeuroVision AI - Environment Configuration Template
# Copy this file to .env and configure for your environment

# Backend Serving Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://neurovision-ai-3d.web.app,https://neurovision-ai-3d.firebaseapp.com

# Model Checkpoint Paths
MODEL_SEGMENTATION_PATH=checkpoints/adaptive/best.pth
MODEL_CLASSIFIER_PATH=checkpoints/classifier/best.pth

# Security & Session Retention
MAX_UPLOAD_SIZE=52428800
TEMP_SESSION_DIRECTORY=dashboard/backend/runtime/sessions
SESSION_RETENTION_MINUTES=60
